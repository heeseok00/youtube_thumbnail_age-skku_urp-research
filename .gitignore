# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── 가상환경 ──────────────────────────────────────────────────────────────
# conda 환경 yaml은 envs/ 에서 추적 (yaml·README만 추적, 나머지는 무시)
envs/*
!envs/*.yaml
!envs/README.md
venv/
.venv/
ytvenv/

# ── 썸네일 이미지 (용량 큰 원본 이미지) ────────────────────────────────
thumbnails/
thumbnails_*/
**/thumbnails/
Sample_images/

# ── 임베딩 (대용량 바이너리) ──────────────────────────────────────────────
artifacts/embeddings/**/*.npy
artifacts/**/embeddings/**/*.npy

# ── attention/gradcam 대용량 산출물 (재실행으로 재현 가능) ────────────────
6_썸네일_attention_gradcam/outputs/
7_HEALTH_다이어트_분석/*/outputs/
7_HEALTH_다이어트_분석/*/checkpoints/
8_ALL_categories_gradcam/outputs/
*.pkl

# ── 데이터 백업 zip ───────────────────────────────────────────────────────
*.zip

# ── HuggingFace / 로컬 모델 가중치 (재다운로드 가능) ──────────────────────
.cache/
*.bin
*.safetensors
*.pt
*.pth
*.task

# ── artifacts 중 재현 가능한 중간 산출물 ──────────────────────────────────
# CSV·JSON 결과는 추적, npy 임베딩만 제외 (위에서 처리)
# artifacts/ 전체를 무시하려면 아래 주석 해제
# artifacts/

# ── archive (과거 산출물 보관용, 로컬에만 유지) ───────────────────────────
# 대용량 구버전 데이터 CSV가 많아 git 추적에서 제외 (기존 히스토리에는 남아 있음)
archive/

# ── 대용량 데이터셋 CSV ───────────────────────────────────────────────────
# YouTube API로 수집한 원본 데이터 (재현하려면 직접 수집 필요)
Data/
data/
# 노트북 로컬 data/ 산출물도 제외 (6_ 파이프라인)
**/data/*.csv

# ── 피처 파이프라인 임시/폐기 체크포인트 ──────────────────────────────────
*_OLD_buggy.csv
**/checkpoints/*_OLD*
**/checkpoints/*_rerun.log

